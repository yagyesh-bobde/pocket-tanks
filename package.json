{
  "name": "pocket-tanks-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-report.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "capture": "node scripts/capture.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.js *.json index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0"
  }
}
